# Copy to .env.local. Never commit secrets.
# Fixture is explicit and is only for local development/tests.
WAFFO_MODE=fixture
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=data/newsletter-cover.sqlite

# WAFFO_LIVE is ignored. The former Polar variables are quarantined and are
# intentionally absent: only WAFFO_MODE selects a provider.
